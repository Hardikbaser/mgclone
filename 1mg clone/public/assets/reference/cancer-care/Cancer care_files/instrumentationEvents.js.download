function getDeviceVal(){
  return navigator.userAgent && navigator.userAgent.indexOf("Mobile") > -1
  ? "mobile"
  : "desktop";
}
function getUserId(){
  return document.cookie
  .split("; ")
  .find((row) => row.startsWith("userId="))
  ?.split("=")[1];
}
// Function returns  json for rudder analytics

function getJson(action) {
