function getShinglesJson({data={} ,type}) {
  let json = {};
  let deviceVal =getDeviceVal();
  let UserID = getUserId();
    switch (type) {
      //////Shingles page
      case "Shinglestopnav_click_linkWhatisShingles":
        json = {
          action: "topnav_click_link",
          rudderData: {
            label: "WhatisShingles",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglestopnav_click_linkWhosMostatRisk":
        json = {
          action: "topnav_click_link",
          rudderData: {
            label: "Who'sMostatRisk",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglestopnav_click_linkWhatcanyoudo":
        json = {
          action: "topnav_click_link",
          rudderData: {
            label: "Whatcanyoudo",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglestopnav_click_linkVaccination":
        json = {
          action: "topnav_click_link",
          rudderData: {
            label: "Vaccination",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglescta_click_know_more_from_educator":
        json = {
          action: "cta_click_know_more_from_educator",
          rudderData: {
            label: "",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglesrequest_a_call_back_dialog_box_open":
        json = {
          action: "request_a_call_back_dialog_box_open",
          rudderData: {
            label: "",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglescta_click_request_a_call_back":
        json = {
          action: "cta_click_request_a_call_back",
          rudderData: {
            label: {
              form_filled: {
                phonenumber: /^[0-9]{10}$/.test(data.phonenumber) ?data.phonenumber:null, 
                name:typeof data.name==='string'?data.name:null,
              },
            },
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglesshingles_page_visited":
        json = {
          type: "page",
          name: "ShinglesPageVisited",
          properties: {
          title: "ShinglesPageVisited",
          url: "https://www.1mg.com/information/shingles",
          },
        };
        break;
  
      case "Shinglescta_click_get_a_free_call_back":
        json = {
          action: "cta_click_get_a_free_call_back",
          rudderData: {
            label: "",
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
  
      case "Shinglescta_cross_sign_request_a_call_back":
        json = {
          action: "cta_cross_sign_request_a_call_back",
          rudderData: {
            label: {
              form_filled: {
                phonenumber: /^[0-9]{10}$/.test(data.phonenumber) ?data.phonenumber:null, 
                name:typeof data.name==='string'?data.name:null,
              },
            },
            category: "ShinglesInformation",
            device: deviceVal,
          },
        };
        break;
      default:
    }
    return json;
}